<?xml version="1.0" encoding="utf-8"?>
<!-- User message row: right-aligned bubble + user avatar on the right.
     Inspired by FabioSilva11/Sketchware-IA's item_message_user.xml.
     The bubble uses the AI accent color so it stands out from the bot
     bubble (white surface with border). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/ai_bubble_user"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/ai_avatar_user_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/ai_user_avatar_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
