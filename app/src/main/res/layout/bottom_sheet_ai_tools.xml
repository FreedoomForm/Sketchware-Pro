<?xml version="1.0" encoding="utf-8"?>
<!-- Attach-tools bottom sheet — ported from FabioSilva11/Sketchware-IA
     bottom_sheet_kelivo_tools.xml. Opens when the user taps the paperclip
     (+) button in the chat input bar.
     Layout: drag handle · 3 tile columns (Camera / Photos / Upload). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ai_bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/ai_sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ai_attach_sheet_title"
        android:textColor="@color/ai_chat_text_primary"
        android:textSize="16sp" />

    <!-- Three tiles row: Camera · Photos · Upload -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tool_camera"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:background="@drawable/ai_tool_tile_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/kelivo_lucide_camera"
                app:tint="@color/ai_chat_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_attach_tool_camera"
                android:textColor="@color/ai_chat_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_photos"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/ai_tool_tile_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/kelivo_lucide_image"
                app:tint="@color/ai_chat_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_attach_tool_photos"
                android:textColor="@color/ai_chat_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_upload"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/ai_tool_tile_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/kelivo_lucide_paperclip"
                app:tint="@color/ai_chat_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_attach_tool_upload"
                android:textColor="@color/ai_chat_text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
