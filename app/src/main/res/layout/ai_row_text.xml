<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant message row — ported from FabioSilva11/Sketchware-IA item_message_bot.xml.
     Layout: avatar + sender name + time, status chip, reasoning block (collapsible),
     streaming dots, message text, action row (copy/refresh/edit/speak/more), token count.
     IDs preserved for ChatAdapter.TextHolder compatibility: text, avatar_icon,
     avatar_container, message_actions, action_copy, token_count, streaming_dots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <!-- Top row: avatar + sender name + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/ai_avatar_bg">

            <ImageView
                android:id="@+id/avatar_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/ai_chat_model_icon"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <TextView
                android:id="@+id/avatar_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="AI"
                android:textColor="@color/ai_avatar_text"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/sender_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/ai_chat_text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Optional status chip ("Thinking", "Running", "Done") -->
    <TextView
        android:id="@+id/status_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ai_chat_status_chip_bg"
        android:gravity="center"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:textColor="@color/ai_chat_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Optional reasoning block (collapsible) -->
    <LinearLayout
        android:id="@+id/reasoning_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ai_json_box_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/ai_chat_reasoning_label"
                android:src="@drawable/kelivo_icon_idea_01_stroke_rounded"
                app:tint="@color/ai_chat_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/ai_chat_reasoning_label"
                android:textColor="@color/ai_chat_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/action_toggle_reasoning"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_chat_show_reasoning"
                android:padding="7dp"
                android:src="@drawable/ic_mtrl_preview"
                app:tint="@color/ai_chat_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/reasoning_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Streaming typing dots -->
    <com.sketchware.ai.ui.chat.TypingDotsView
        android:id="@+id/streaming_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Main message text -->
    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ai_chat_text_primary"
        android:textSize="15sp" />

    <!-- Message action row (copy, regenerate, edit, speak, more) + token count -->
    <LinearLayout
        android:id="@+id/message_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/action_copy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_action_copy"
            android:padding="5dp"
            android:src="@drawable/kelivo_lucide_copy"
            app:tint="@color/ai_chat_text_secondary" />

        <ImageView
            android:id="@+id/action_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_action_refresh"
            android:padding="5dp"
            android:src="@drawable/kelivo_lucide_refresh_cw"
            app:tint="@color/ai_chat_text_secondary" />

        <ImageView
            android:id="@+id/action_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_action_edit"
            android:padding="5dp"
            android:src="@drawable/kelivo_lucide_edit"
            app:tint="@color/ai_chat_text_secondary" />

        <ImageView
            android:id="@+id/action_speak"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_action_speak"
            android:padding="5dp"
            android:src="@drawable/kelivo_lucide_volume_2"
            app:tint="@color/ai_chat_text_secondary" />

        <ImageView
            android:id="@+id/action_more"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_action_more"
            android:padding="5dp"
            android:src="@drawable/kelivo_lucide_more_horizontal"
            app:tint="@color/ai_chat_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/token_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ai_chat_text_hint"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
