<?xml version="1.0" encoding="utf-8"?>
<!-- Cline-style assistant text: full-width with left accent bar.
     The accent bar gives assistant messages a visual anchor on the left,
     matching Cline's sidebar layout where assistant responses have a
     subtle left-border accent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="48dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Left accent bar (Cline-style) -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="?attr/colorPrimary" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />
</LinearLayout>
