<?xml version="1.0" encoding="utf-8"?>
<!-- Provider detail activity.
     Two tabs at the bottom: Config and Models.
     Config tab: API key, base URL, API path, max tokens, switches for
                 reasoning/streaming/images/prompt-caching/flat-tool-format,
                 reasoning effort dropdown.
     Models tab: list of built-in models for this provider + custom models
                 + Fetch button (autodetect from /models) + Add Model button.
     Top toolbar: provider name + back nav + Save action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_chat_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ai_chat_surface"
        android:minHeight="?attr/actionBarSize"
        app:menu="@menu/ai_provider_detail_menu"
        app:navigationIcon="@drawable/ic_mtrl_back"
        app:navigationIconTint="@color/ai_chat_text_primary"
        app:titleTextColor="@color/ai_chat_text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ai_chat_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============= Config Tab ============= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/config_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="96dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <!-- Provider header card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/ai_chat_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ai_chat_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/ai_avatar_bg">

                            <ImageView
                                android:id="@+id/provider_icon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:scaleType="centerInside" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/provider_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/provider_family"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ai_chat_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ai_provider_status_badge"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:minWidth="40dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/ai_provider_status_on_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- API Key -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/ai_provider_detail_api_key"
                    app:boxBackgroundColor="@color/ai_chat_surface"
                    app:boxStrokeColor="@color/ai_chat_border"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Base URL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/ai_provider_detail_base_url"
                    app:boxBackgroundColor="@color/ai_chat_surface"
                    app:boxStrokeColor="@color/ai_chat_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_base_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- API Path -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/ai_provider_detail_api_path"
                    app:boxBackgroundColor="@color/ai_chat_surface"
                    app:boxStrokeColor="@color/ai_chat_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_api_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Model ID -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Model ID"
                    app:boxBackgroundColor="@color/ai_chat_surface"
                    app:boxStrokeColor="@color/ai_chat_border"
                    app:endIconDrawable="@drawable/ic_mtrl_chevron_right_24"
                    app:endIconMode="custom"
                    app:endIconTint="@color/ai_chat_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_model_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reasoning effort -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Reasoning effort"
                    app:boxBackgroundColor="@color/ai_chat_surface"
                    app:boxStrokeColor="@color/ai_chat_border">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/spinner_reasoning_effort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Max tokens + Context window row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Max output tokens"
                        app:boxBackgroundColor="@color/ai_chat_surface"
                        app:boxStrokeColor="@color/ai_chat_border">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_max_tokens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Context window (0 = auto)"
                        app:boxBackgroundColor="@color/ai_chat_surface"
                        app:boxStrokeColor="@color/ai_chat_border">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_context_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Switches card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/ai_chat_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ai_chat_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Enable reasoning"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="14sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_reasoning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ai_chat_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Enable streaming"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="14sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_streaming"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ai_chat_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Image support"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="14sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_image_support"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ai_chat_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Prompt caching"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="14sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_prompt_caching"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ai_chat_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Force flat tool format"
                                android:textColor="@color/ai_chat_text_primary"
                                android:textSize="14sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_force_flat_tool_format"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@color/ai_chat_accent"
                    android:text="@string/ai_provider_detail_save"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============= Models Tab ============= -->
        <LinearLayout
            android:id="@+id/models_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/models_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/ai_chat_surface"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="100dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/models_empty_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/ai_models_empty_subtitle"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Floating action pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/ai_action_pill_bg"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fetch_models"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_models_fetch"
                    android:textColor="@color/ai_chat_accent"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_mtrl_download"
                    app:iconSize="18dp"
                    app:iconTint="@color/ai_chat_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_model"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/ai_chat_accent_soft"
                    android:text="@string/ai_models_add"
                    android:textColor="@color/ai_chat_text_primary"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_mtrl_add"
                    app:iconSize="18dp"
                    app:iconTint="@color/ai_chat_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom tab bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ai_chat_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_config"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icon_tab_config"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/ai_chat_accent" />

                <TextView
                    android:id="@+id/label_tab_config"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_provider_detail_config"
                    android:textColor="@color/ai_chat_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_models"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icon_tab_models"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mtrl_package"
                    app:tint="@color/ai_chat_text_secondary" />

                <TextView
                    android:id="@+id/label_tab_models"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_provider_detail_models"
                    android:textColor="@color/ai_chat_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
