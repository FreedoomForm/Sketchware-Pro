<?xml version="1.0" encoding="utf-8"?>
<!-- Section header row inside the model-picker bottom sheet: shows the
     provider icon (24dp) + provider display name. Ported from reference
     item_kelivo_provider_header.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/provider_header_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_ai" />

    <TextView
        android:id="@+id/provider_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAllCaps="false"
        android:textColor="@color/ai_chat_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
