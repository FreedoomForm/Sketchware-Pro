<?xml version="1.0" encoding="utf-8"?>
<!-- Tool-call card — ported from FabioSilva11/Sketchware-IA item_message_tool.xml.
     Layout: header (icon + tool name + status icon + spinner + expand arrow) +
     collapsible details (args JSON box + result label + result box + approval buttons).
     IDs preserved for ChatAdapter.ToolHolder compatibility: tool_name, tool_args,
     tool_result, progress. New optional IDs: tool_status_icon, layout_tool_details,
     img_expand, btn_reject, btn_approve, text_tool_notice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/ai_tool_card_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Header: icon + name + status + progress + expand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tool_status_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/kelivo_lucide_hammer"
            app:tint="@color/ai_chat_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tool_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ai_chat_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_tool_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/img_tool_status"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mtrl_check"
            android:visibility="gone"
            app:tint="@color/ai_chat_accent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_expand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/ic_mtrl_arrow_down"
            app:tint="@color/ai_chat_text_secondary" />
    </LinearLayout>

    <!-- Collapsible details -->
    <LinearLayout
        android:id="@+id/layout_tool_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tool_args"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ai_json_box_bg"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/text_result_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Result"
            android:textColor="@color/ai_chat_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/ai_json_box_bg"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="@color/ai_chat_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_tool_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/approval_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Reject"
                android:textColor="@color/ai_status_error"
                android:textSize="12sp"
                app:icon="@drawable/ic_close"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_approve"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/ai_chat_accent"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Approve"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:icon="@drawable/ic_approve"
                app:iconSize="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
