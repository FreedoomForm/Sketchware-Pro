<?xml version="1.0" encoding="utf-8"?>
<!-- Full AI chat page UI — ported from FabioSilva11/Sketchware-IA activity_chat.xml.
     Structure:
       DrawerLayout
         ├─ RelativeLayout (main content)
         │    ├─ chat_header   (drawer btn · title · model icon+subtitle · settings · new chat)
         │    ├─ layout_token_meter (icon · tokens · progress bar · percentage)
         │    ├─ status_row   (status dot · status text · mode chip)
         │    ├─ recycler     (messages list)
         │    ├─ thumbnails_scroll (image attachment previews)
         │    ├─ run_status_row (KelivoTypingDotsView + run label)
         │    └─ inputContainer (MaterialCardView, rounded 20dp) with:
         │         · edit_text_message (EditText, 44–180dp height)
         │         · bottom row: model selector · mode toggle · auto-approve · attach · stop · send
         └─ ai_chat_drawer (chat threads side drawer, 300dp wide)

     All IDs that ChatFragment.java depends on are preserved (recycler, input,
     btn_send, btn_stop, btn_attach, btn_mode, auto_approve_toggle, status_dot,
     status_text, tokens_text, tokens_percent, mode_label, chat_title,
     chat_subtitle, chat_model_icon, run_status_row, run_status_text,
     run_status_dots, btn_model_selector, btn_model_selector_icon,
     btn_model_selector_label, context_progress_bar, context_progress,
     btn_chat_menu, btn_chat_settings, btn_chat_clear).

     The agent runtime (ChatFragment.java) is UNCHANGED — only the views and
     their wiring have been enriched. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_chat_background"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ============= Top Header =============
             Background uses ai_chat_background (not ai_chat_surface) so the
             header is the SAME color as the messages RecyclerView below it.
             This eliminates a visible color seam between the header strip
             and the chat pane that previously looked like a horizontal
             divider line whenever the layout was resized (e.g. when the
             soft keyboard appeared). -->
        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@color/ai_chat_background"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btn_chat_menu"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_chat_open_drawer"
                android:padding="10dp"
                android:src="@drawable/kelivo_icon_list2"
                app:tint="@color/ai_chat_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/chat_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ai_chat_title"
                    android:textColor="@color/ai_chat_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/chat_model_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@string/ai_chat_model_icon"
                        android:scaleType="centerInside"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chat_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ai_chat_subtitle_idle"
                        android:textColor="@color/ai_chat_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_chat_settings"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_chat_settings"
                android:padding="8dp"
                android:src="@drawable/ic_kelivo_hammer"
                app:tint="@color/ai_chat_text_primary" />

            <ImageView
                android:id="@+id/btn_chat_clear"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_chat_header_new_chat"
                android:padding="8dp"
                android:src="@drawable/kelivo_lucide_message_circle_plus"
                app:tint="@color/ai_chat_text_primary" />
        </LinearLayout>

        <!-- ============= Token Meter =============
             Same background color as the chat pane (ai_chat_background)
             to avoid a horizontal color seam below the header. -->
        <LinearLayout
            android:id="@+id/layout_token_meter"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_below="@id/chat_header"
            android:background="@color/ai_chat_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/kelivo_icon_codex"
                app:tint="@color/ai_chat_accent" />

            <TextView
                android:id="@+id/tokens_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/ai_chat_token_meter_empty"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/context_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/ai_token_meter_track"
                android:progressTint="@color/ai_token_meter_progress" />

            <TextView
                android:id="@+id/tokens_percent"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============= Status Row (status dot + status text + mode chip) ============= -->
        <!-- Same background color as the chat pane (ai_chat_background) to
             avoid a horizontal color seam above the messages list that
             previously looked like a divider line after the soft keyboard
             appeared and the layout was resized. -->
        <LinearLayout
            android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_token_meter"
            android:background="@color/ai_chat_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/circle_status_dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Idle"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ai_model_chip_bg"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Act"
                android:textColor="@color/ai_chat_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/context_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/status_row"
            android:visibility="gone"
            app:indicatorColor="@color/ai_chat_accent"
            app:trackColor="@color/ai_chat_border" />

        <!-- ============= Messages List ============= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/input_container"
            android:layout_below="@id/context_progress"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <!-- ============= Image Thumbnails (when attached) ============= -->
        <HorizontalScrollView
            android:id="@+id/thumbnails_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/input_container"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/thumbnails_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <!-- ============= Bottom Input Area ============= -->
        <!-- strokeWidth=0dp removes the 1dp border around the input card
             that previously looked like a horizontal divider line below
             the chat pane (especially visible after the soft keyboard
             appeared and the layout was resized). The card still stands
             out from the background because cardBackgroundColor (white)
             differs from the chat background (very light gray). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/ai_chat_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!-- Run status (typing dots + label) — shown while agent is running -->
                <LinearLayout
                    android:id="@+id/run_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/ai_thread_badge_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <com.sketchware.ai.ui.chat.TypingDotsView
                        android:id="@+id/run_status_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/run_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ai_chat_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Auto-approve / YOLO row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/auto_approve_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/ai_chat_accent"
                        app:trackTint="@color/ai_chat_border" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/ai_chat_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/ai_chat_mode_yolo"
                        android:textColor="@color/ai_chat_text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Act / Plan segmented toggle: two side-by-side
                         labels inside a rounded pill track. Tapping a
                         label selects that mode (Act = execute tools,
                         Plan = think only, no tool execution).
                         Replaces the previous MaterialSwitch + icon +
                         label row that the user found confusing. -->
                    <LinearLayout
                        android:id="@+id/btn_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/ai_mode_segment_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp">

                        <TextView
                            android:id="@+id/mode_segment_act"
                            android:layout_width="44dp"
                            android:layout_height="22dp"
                            android:background="@drawable/ai_mode_segment_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/ai_chat_mode_act"
                            android:textColor="@color/ai_mode_segment_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mode_segment_plan"
                            android:layout_width="44dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/ai_mode_segment_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/ai_chat_mode_plan"
                            android:textColor="@color/ai_mode_segment_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Inline label kept for backward-compat with existing
                         code that reads modeLabelInline; now hidden since
                         the segmented toggle already shows the labels. -->
                    <TextView
                        android:id="@+id/mode_label_inline"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- EditText -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/ai_chat_input_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lineSpacingExtra="2dp"
                    android:maxHeight="180dp"
                    android:minHeight="44dp"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingTop="0dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/ai_chat_text_primary"
                    android:textColorHint="@color/ai_chat_text_hint"
                    android:textSize="15sp" />

                <!-- Bottom action row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp">

                    <LinearLayout
                        android:id="@+id/btn_model_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/ai_model_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/btn_model_selector_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/ai_chat_model_selector_desc"
                            android:src="@drawable/kelivo_icon_codex"
                            app:tint="@color/ai_chat_accent" />

                        <TextView
                            android:id="@+id/btn_model_selector_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:text="gpt-4o"
                            android:textColor="@color/ai_model_chip_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_attach"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/ai_chat_attach"
                        app:icon="@drawable/ic_attach"
                        app:iconSize="18dp"
                        app:iconTint="@color/ai_chat_text_primary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_stop"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ai_chat_cancel_run"
                        android:padding="7dp"
                        android:src="@drawable/kelivo_icon_stop"
                        android:visibility="gone"
                        app:tint="@color/ai_chat_text_secondary" />

                    <ImageView
                        android:id="@+id/btn_send"
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/ai_send_bg"
                        android:contentDescription="@string/ai_chat_send"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/kelivo_lucide_arrow_up"
                        app:tint="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- ============= Side Drawer (chat threads) ============= -->
    <!-- 340dp ≈ 89% of a 380dp screen, so the drawer covers most of the
         chat content when open without completely hiding it. -->
    <include
        android:id="@+id/chat_drawer_content"
        layout="@layout/ai_chat_drawer"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
