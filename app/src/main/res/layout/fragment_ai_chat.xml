<?xml version="1.0" encoding="utf-8"?>
<!-- Enriched AI chat layout (ported UI concepts from FabioSilva11/Sketchware-IA).
     Top: chat header with model icon + name + drawer button + new-chat button.
     Token meter: thin progress bar showing context-window fill.
     Messages: RecyclerView with avatar-style rows.
     Input: rounded card with model-selector chip, mode chip, attach, send.

     Core agent runtime (ChatFragment.java) is UNCHANGED — only the views
     and their wiring have been enriched. The agent loop, tool registry,
     block-creation tools, and auto-approver all keep working exactly as
     before; this layout just surfaces more of their state visually. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ai_chat_background">

    <!-- ============= Top Header (compact) ============= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/ai_chat_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/btn_chat_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_open_drawer"
            android:padding="9dp"
            android:src="@drawable/ic_mtrl_menu"
            app:tint="@color/ai_chat_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ai_chat_title"
                android:textColor="@color/ai_chat_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chat_model_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chat_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ai_chat_subtitle_idle"
                    android:textColor="@color/ai_chat_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_chat_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_settings"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/ai_chat_text_primary" />

        <ImageView
            android:id="@+id/btn_chat_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_new_chat"
            android:padding="9dp"
            android:src="@drawable/ic_mtrl_add"
            app:tint="@color/ai_chat_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ai_chat_border" />

    <!-- ============= Token Meter ============= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/ai_chat_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ai"
            app:tint="@color/ai_chat_accent" />

        <TextView
            android:id="@+id/tokens_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/ai_chat_token_meter_empty"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/context_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/ai_chat_border"
            android:progressTint="@color/ai_chat_accent" />

        <TextView
            android:id="@+id/tokens_percent"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0%"
            android:textColor="@color/ai_chat_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============= Status Row (running state + status dot) ============= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@color/ai_chat_surface">

        <View
            android:id="@+id/status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/circle_status_dot" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Idle"
            android:textSize="11sp"
            android:textColor="@color/ai_chat_text_secondary" />

        <TextView
            android:id="@+id/mode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/ai_chat_accent"
            android:fontFamily="monospace"
            android:background="@drawable/ai_model_chip_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/context_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone"
        app:indicatorColor="@color/ai_chat_accent"
        app:trackColor="@color/ai_chat_border" />

    <!-- ============= Messages List ============= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />

    <!-- ============= Image Thumbnails (when attached) ============= -->
    <HorizontalScrollView
        android:id="@+id/thumbnails_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/thumbnails_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </HorizontalScrollView>

    <!-- ============= Running Status Row (typing dots + label) ============= -->
    <LinearLayout
        android:id="@+id/run_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ai_run_status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <com.sketchware.ai.ui.chat.TypingDotsView
                android:id="@+id/run_status_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/run_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ai_chat_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============= Bottom Input Area ============= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ai_chat_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <!-- Auto-approve row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/auto_approve_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/ai_chat_accent"
                app:trackTint="@color/ai_chat_border" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/ai_chat_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ai_chat_mode_yolo"
                android:textSize="11sp"
                android:textColor="@color/ai_chat_text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/ai_chat_mode_act"
                android:textColor="@color/ai_chat_accent"
                android:textSize="12sp"
                app:icon="@drawable/ic_play"
                app:iconSize="14dp"
                app:iconTint="@color/ai_chat_accent" />
        </LinearLayout>

        <!-- Input card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ai_chat_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ai_chat_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ai_chat_input_hint"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minLines="1"
                    android:padding="4dp"
                    android:imeOptions="actionSend"
                    android:textSize="14sp"
                    android:textColor="@color/ai_chat_text_primary"
                    android:textColorHint="@color/ai_chat_text_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/btn_model_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/ai_model_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/btn_model_selector_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ai"
                            app:tint="@color/ai_chat_accent" />

                        <TextView
                            android:id="@+id/btn_model_selector_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:text="gpt-4o"
                            android:textColor="@color/ai_model_chip_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_attach"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_attach"
                        app:iconSize="18dp"
                        app:iconTint="@color/ai_chat_text_secondary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_stop"
                        app:iconSize="16dp"
                        android:backgroundTint="@color/ai_status_error" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_send"
                        app:iconSize="18dp"
                        android:backgroundTint="@color/ai_chat_accent" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
