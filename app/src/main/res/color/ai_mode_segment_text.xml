<?xml version="1.0" encoding="utf-8"?>
<!-- Text color selector for segmented toggle labels.
     Selected segment = white text (on accent background),
     Unselected segment = secondary text color (on the gray track). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@android:color/white" />
    <item android:state_enabled="false" android:color="@color/ai_chat_text_hint" />
    <item android:color="@color/ai_chat_text_secondary" />
</selector>
