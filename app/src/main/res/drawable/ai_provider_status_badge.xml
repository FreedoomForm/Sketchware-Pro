<?xml version="1.0" encoding="utf-8"?>
<!-- Status badge background for provider rows in the settings list.
     Selector picks green (ON) when state_selected, amber (OFF) otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_provider_status_on_bg" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_provider_status_off_bg" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
